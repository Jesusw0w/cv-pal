# Copy to .env and set CV_PAL_SECRET_KEY. Never commit .env.
#
# As shipped this file boots the app with no credentials and no cost: the LLM
# provider defaults to a local Ollama server. Swap in the hosted block below when
# you want a hosted model.

# Required — the app refuses to start without it.
# Generate one:  python -c "import secrets; print(secrets.token_hex(32))"
CV_PAL_SECRET_KEY=

CV_PAL_DATABASE_URL=sqlite+aiosqlite:///./cv_pal.db
CV_PAL_ACCESS_TOKEN_EXPIRE_MINUTES=30
# Set false once your account exists, so the instance stops accepting new sign-ups.
CV_PAL_ALLOW_REGISTRATION=true
# JSON list. Must include the frontend origin or the browser blocks the calls.
CV_PAL_CORS_ORIGINS=["http://localhost:4200"]

# --- LLM: fully local, nothing leaves the machine (default) ---
#   1. install Ollama: https://ollama.com/download
#   2. ollama pull llama3
# The app starts whether or not Ollama is running; only the analyse endpoint needs it.
CV_PAL_LLM_PROVIDER=ollama
CV_PAL_LLM_MODEL=llama3
CV_PAL_LLM_BASE_URL=http://localhost:11434/v1
# Refuse to contact any hosted provider at all.
# CV_PAL_LOCAL_ONLY=true

# --- LLM: hosted, Claude ---
# Uses Anthropic's own SDK, not an OpenAI-compatible shim. Leave the model unset for a
# sensible current default; CV_PAL_LLM_BASE_URL does not apply.
# CV_PAL_LLM_PROVIDER=anthropic
# CV_PAL_LLM_API_KEY=sk-ant-...
# CV_PAL_LLM_MODEL=claude-sonnet-5

# --- LLM: hosted, OpenAI ---
# CV_PAL_LLM_PROVIDER=openai
# CV_PAL_LLM_API_KEY=sk-...
# CV_PAL_LLM_MODEL=gpt-4o-mini

# --- LLM: any other OpenAI-compatible endpoint (vLLM, LM Studio, OpenRouter) ---
# CV_PAL_LLM_PROVIDER=custom
# CV_PAL_LLM_API_KEY=...
# CV_PAL_LLM_BASE_URL=https://example.invalid/v1
