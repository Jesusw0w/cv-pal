# Configuration for `docker compose up`. Copy to .env and set the secret key.
#
#   cp .env.docker.example .env
#
# .env is gitignored. Never commit it.

# Required — the backend refuses to start without it, by design.
# Generate one:  openssl rand -hex 32
CV_PAL_SECRET_KEY=

# Which published version to run. Unset tracks the newest release; pin it to keep an
# instance on a known version. `docker compose pull` is what applies a change either way.
# CV_PAL_VERSION=0.1.0

# --- Language model ---
#
# Option A: a local model, nothing leaves your machine (default).
#   Start the stack with:  docker compose --profile ollama up -d
#   Then pull a model:     docker compose exec ollama ollama pull llama3
CV_PAL_LLM_PROVIDER=ollama
CV_PAL_LLM_MODEL=llama3
CV_PAL_LLM_BASE_URL=http://ollama:11434/v1
# Refuse to contact any hosted provider at all. Checked against the base URL as well as
# the provider name, so a hosted endpoint behind `ollama` is rejected at start-up.
CV_PAL_LOCAL_ONLY=true

# Option A2: Ollama already installed on this computer. Better than the container above
# if you have a graphics card — the container cannot use it on Windows, and it downloads
# its own copy of every model. Start with plain `docker compose up -d`, no profile.
# CV_PAL_LLM_BASE_URL=http://host.docker.internal:11434/v1
# CV_PAL_LLM_MODEL=<whatever `ollama list` shows>


# Option B: a hosted model. Comment out the Ollama block above first.
# CV_PAL_LLM_PROVIDER=openai
# CV_PAL_LLM_API_KEY=sk-...
# CV_PAL_LLM_MODEL=gpt-4o-mini
# CV_PAL_LOCAL_ONLY=false

# --- Agents (MCP) ---
# An MCP endpoint at http://localhost:8080/api/mcp, for an agent you run yourself
# (Claude Code, Claude Desktop, ...). Off by default: it is a second way into your data.
# Create a token in Settings → Agent access once it is on.
#
# It cannot be combined with CV_PAL_LOCAL_ONLY=true — the agent's model may be hosted,
# so the backend refuses to start with both. Set CV_PAL_LOCAL_ONLY=false above first.
# CV_PAL_MCP_ENABLED=true

# --- Sessions ---
CV_PAL_ACCESS_TOKEN_EXPIRE_MINUTES=30
CV_PAL_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Accounts ---
# Open, because a fresh instance has no account yet and closing it would lock you out.
# Create yours, then set this to false and `docker compose up -d` again. Do that before
# exposing the app beyond 127.0.0.1: until you do, anyone who can reach it can sign up.
CV_PAL_ALLOW_REGISTRATION=true

# Session cookies marked Secure. Leave off for the default http://localhost setup; turn
# on when a reverse proxy serves the app over HTTPS.
# CV_PAL_COOKIE_SECURE=true
